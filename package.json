{
  "name": "unmanned-supermarket",
  "version": "1.0.0",
  "description": "无人自助超市管理系统：Node.js + Express + MongoDB，涵盖登录鉴权、商品管理、库存预警、进货闭环、订单选购与数据统计",
  "private": true,
  "main": "bin/www",
  "scripts": {

<%- include('../partials/header', { title: '订单管理' }) %>
</head>

<body>
  <%- include('../partials/nav') %>
  <div class="container">
    <div class="page-header-bar">
      <h3>订单管理</h3>
    </div>

    <div style="margin-bottom: 16px;">
      <a href="/orders/create" class="btn btn-primary">+ 顾客选购下单</a>
    </div>

    <% if (orders.length === 0) { %>
      <p class="text-muted">暂无订单</p>
    <% } else { %>
      <table class="table table-bordered table-hover bg-white">
        <tr>
          <th>订单号</th>
          <th>顾客</th>
          <th>商品明细</th>
          <th>总价（元）</th>
          <th>状态</th>
          <th>下单时间</th>
          <th>操作</th>
        </tr>
        <% orders.forEach(function (o) { %>
          <tr>
            <td><%= o.orderNo %></td>
            <td><%= o.customer %></td>
            <td>
              <% o.items.forEach(function (it) { %>
                <div><%= it.name %> × <%= it.quantity %>（<%= it.price.toFixed(2) %> 元）</div>
              <% }) %>
            </td>
            <td><%= o.totalAmount.toFixed(2) %></td>
            <td><span class="label label-success"><%= o.status %></span></td>
            <td><%= o.createdAt.toLocaleString('zh-CN') %></td>
            <td>
              <% if (user.role === 'admin') { %>
                <a href="/orders/<%= o._id %>/delete" class="btn btn-xs btn-danger"
                  onclick="return confirm('确定删除该订单吗？')">删除</a>
              <% } %>
            </td>
          </tr>
        <% }) %>
      </table>
    <% } %>
  </div>
  <%- include('../partials/footer') %>

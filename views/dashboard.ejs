<%- include('partials/header', { title: '首页统计' }) %>
</head>

<body>
  <%- include('partials/nav') %>
  <div class="container">
    <div class="page-header-bar">
      <h3>首页统计</h3>
    </div>

    <div class="row">
      <div class="col-xs-6 col-md-3">
        <div class="stat-card">
          <div>商品总数</div>
          <div class="num"><%= productCount %></div>
        </div>
      </div>
      <div class="col-xs-6 col-md-3">
        <div class="stat-card warn">
          <div>库存预警商品</div>
          <div class="num"><%= lowStockCount %></div>
        </div>
      </div>
      <div class="col-xs-6 col-md-3">
        <div class="stat-card success">
          <div>今日订单</div>
          <div class="num"><%= todayOrders %></div>
        </div>
      </div>
      <div class="col-xs-6 col-md-3">
        <div class="stat-card">
          <div>销售总额（元）</div>
          <div class="num"><%= totalSales.toFixed(2) %></div>
        </div>
      </div>
    </div>

    <div class="row">
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">
            库存预警商品
            <span class="pull-right">
              <a href="/purchases/create">去进货 →</a>
            </span>
          </div>
          <div class="panel-body">
            <% if (lowStockProducts.length === 0) { %>
              <p class="text-muted">暂无预警商品，库存状态良好</p>
            <% } else { %>
              <table class="table table-bordered">
                <tr><th>商品</th><th>库存</th><th>安全线</th></tr>
                <% lowStockProducts.forEach(function (p) { %>
                  <tr>
                    <td><%= p.name %></td>
                    <td class="low-stock"><%= p.stock %> <%= p.unit %></td>
                    <td><%= p.safetyStock %></td>
                  </tr>
                <% }) %>
              </table>
            <% } %>
          </div>
        </div>
        <p class="text-muted">待收货进货单：<a href="/purchases"><%= pendingPurchases %> 单</a></p>
      </div>
      <div class="col-md-6">
        <div class="panel panel-default">
          <div class="panel-heading">最近订单</div>
          <div class="panel-body">
            <% if (recentOrders.length === 0) { %>
              <p class="text-muted">暂无订单</p>
            <% } else { %>
              <table class="table table-bordered">
                <tr><th>订单号</th><th>顾客</th><th>金额（元）</th></tr>
                <% recentOrders.forEach(function (o) { %>
                  <tr>
                    <td><%= o.orderNo %></td>
                    <td><%= o.customer %></td>
                    <td><%= o.totalAmount.toFixed(2) %></td>
                  </tr>
                <% }) %>
              </table>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </div>
  <%- include('partials/footer') %>
